{
  "id": "rigaya.NVEnc",
  "name": "NVEnc",
  "version": "1.0.0",
  "vendor": "rigaya（znd 移植: znd-plugins）",
  "license": "MIT",
  "description": "NVENCによる高速エンコードの性能実験",
  "permissions": [],
  "exporters": [
    {
      "id": "nvenc",
      "label": "NVEnc（NVIDIA GPU）",
      "extension": "mp4",
      "even": true,
      "video_args": [
        "-c:v",
        "{codec}",
        "-preset",
        "{preset}",
        "-cq",
        "{q}",
        "-pix_fmt",
        "yuv420p",
        "{extra}",
        "-movflags",
        "+faststart"
      ],
      "audio_args": [
        "-c:a",
        "aac",
        "-b:a",
        "{abr}k"
      ],
      "params": [
        {
          "id": "codec",
          "label": "コーデック",
          "type": "choice",
          "default": 0,
          "options": [
            {
              "label": "H.264",
              "value": "h264_nvenc"
            },
            {
              "label": "HEVC",
              "value": "hevc_nvenc"
            },
            {
              "label": "AV1",
              "value": "av1_nvenc"
            }
          ]
        },
        {
          "id": "q",
          "label": "画質（小さいほど高画質）",
          "type": "number",
          "default": 23,
          "min": 0,
          "max": 51
        },
        {
          "id": "preset",
          "label": "プリセット",
          "type": "choice",
          "default": 3,
          "options": [
            "p1",
            "p2",
            "p3",
            "p4",
            "p5",
            "p6",
            "p7"
          ]
        },
        {
          "id": "abr",
          "label": "音声ビットレート（kbps）",
          "type": "number",
          "default": 256,
          "min": 32,
          "max": 512
        },
        {
          "id": "extra",
          "label": "追加の引数",
          "type": "args",
          "default": ""
        }
      ],
      "description": "NVIDIA の GPU と、NVENC に対応した FFmpeg が必要"
    }
  ]
}